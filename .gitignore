# Secrets
.env
# Timestamped .env copies taken before a config change (e.g. the Turso
# removal on 2026-08-24). Same secrets as .env itself under a filename
# the bare `.env` pattern does not match.
.env.backup-*
.streamlit/secrets.toml

# Local runtime state (SQLite DBs, personal data)
data/*.db
# SQLite journal/WAL sidecars - same personal data as data/*.db above, just
# under different filenames.
data/*.db-shm
data/*.db-wal
# Manual quarantine backups (a corrupted db renamed aside rather than
# deleted) - same personal data as data/*.db above under a filename none of
# the patterns above match.
data/*.corrupt-backup-*
# Pre-bulk-operation rescue copies. Originally added because Turso's replica
# sync could overwrite a good local db from an empty remote; kept after Turso
# was removed because copying a db aside before a bulk write is worth doing
# regardless, and data/ has no backup.
data/*.rescue-*
data/tailored/

# Personal resume/CV content and generated per-company tailored output
cv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environment
.venv/

# uv
# (uv.lock is intentionally NOT ignored - it's committed for reproducible installs)
.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml
