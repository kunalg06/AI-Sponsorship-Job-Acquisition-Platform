# Secrets
.env
.streamlit/secrets.toml
turso.env

# Local runtime state (SQLite DBs, personal data)
data/*.db
# libsql embedded-replica sidecars (dbcompat.connect's Turso path) and the
# quarantined pre-Turso file it backs up before replacing - same personal
# data as data/*.db above, just under different filenames.
data/*.db-info
data/*.db-shm
data/*.db-wal
data/*.pre-turso-backup
# Manual quarantine backups (a corrupted local replica renamed aside rather
# than deleted) - same personal data as data/*.db above under a filename
# none of the patterns above match.
data/*.corrupt-backup-*
# Pre-ingest rescue copies. dbcompat.connect() syncs the embedded replica from
# the remote on open, so a remote that is empty/stale silently overwrites a
# good local register - copy it aside under this name before any ingest run.
data/*.rescue-*
data/tailored/

# Personal resume/CV content and generated per-company tailored output
cv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environment
.venv/

# uv
# (uv.lock is intentionally NOT ignored - it's committed for reproducible installs)
.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml
